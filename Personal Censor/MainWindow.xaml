<Window x:Class="Personal_Censor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Personal_Censor"
        mc:Ignorable="d"
        Title="Personal Censor" Height="360" Width="640" Topmost="True" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip">
    <Grid x:Name="mainGrid"
    Background="Black" MouseRightButtonDown="Grid_MouseRightButtonDown" PreviewMouseWheel="Grid_PreviewMouseWheel"
    MouseLeftButtonDown="Grid_MouseLeftButtonDown" MouseMove="Grid_MouseMove" MouseLeftButtonUp="Grid_MouseLeftButtonUp">
        <StackPanel x:Name="panel" Orientation="Horizontal" VerticalAlignment="Top" Background="#FF2F2F2F">
            <TextBlock Name="titleText"  Text="Personal Censor" Foreground="White" VerticalAlignment="Center" Margin="3" Height="16" MouseDown="Grid_TitleMouseDown"/>
            <Button Content="■" Foreground="White" Margin="3" Click="BorderlessButton_Click" Width="40" Height="20" BorderBrush="{x:Null}" Background="#FF2F2F2F" FontFamily="BIZ UDGothic"/>
            
            <Button Content="─" Foreground="White" Margin="3" Click="MinimizeButton_Click" Width="40" Height="20" BorderBrush="{x:Null}" Background="#FF2F2F2F" FontFamily="BIZ UDGothic"/>
            <Button Content="□" Foreground="White" Margin="3" Click="MaximizeRestoreButton_Click" Width="40" Height="20" BorderBrush="{x:Null}" Background="#FF2F2F2F" FontFamily="BIZ UDGothic"/>
            <Button Content="❌" Foreground="White" Margin="3" Click="CloseButton_Click" Width="40" Height="20" BorderBrush="{x:Null}" Background="#FF2F2F2F" FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
    
</Window>
